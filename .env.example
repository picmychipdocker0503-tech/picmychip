PAYLOAD_SECRET=mygeneratedsecret
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/template-ecommerce

COMPANY_NAME="Payload Inc."
TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="Payload Commerce"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# PayU API keys (https://docs.payu.in/docs/generate-test-merchant-key-and-salt)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# 'test' or 'production' — defaults to 'test' if unset
PAYU_MODE=test

# Meilisearch (run `docker compose up -d meilisearch` for local dev).
# Search/facets are optional at runtime — the storefront falls back to
# direct database queries if this is unset or unreachable.
MEILI_HOST=http://127.0.0.1:7700
# Generate a strong value for production; any non-empty string works for local dev.
MEILI_MASTER_KEY=dev_meili_master_key_change_me

# Shared secret required by POST /api/search/reindex
REINDEX_SECRET=dev_reindex_secret_change_me

# Transactional email (order confirmation, shipping update, back-in-stock, gift
# card codes). Optional — until SMTP_HOST is set, these emails are logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@picmychip.com
EMAIL_FROM_NAME=PicMyChip

# Shared secret required by POST /api/inventory-webhook (external stock sync)
INVENTORY_WEBHOOK_SECRET=dev_inventory_webhook_secret_change_me
