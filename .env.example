PAYLOAD_SECRET=mygeneratedsecret
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/template-ecommerce

COMPANY_NAME="Payload Inc."
TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="Payload Commerce"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# PayU API keys (https://docs.payu.in/docs/generate-test-merchant-key-and-salt)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# 'test' or 'production' — defaults to 'test' if unset
PAYU_MODE=test

# Meilisearch (run `docker compose up -d meilisearch` for local dev).
# Use http://127.0.0.1:7700 when Payload runs on the host. If Payload runs
# inside this Compose network, use http://meilisearch:7700 instead.
# Search/facets are optional at runtime — the storefront falls back to direct
# database queries if this is unset or unreachable.
MEILI_HOST=http://127.0.0.1:7700
# Generate a strong value for production; any non-empty string works for local dev.
MEILI_MASTER_KEY=dev_meili_master_key_change_me

# Shared secret required by POST /api/search/reindex
REINDEX_SECRET=dev_reindex_secret_change_me

# Transactional email (order confirmation, shipping update, back-in-stock, gift
# card codes, forgot-password, newsletter). Optional — until BREVO_API_KEY or
# SMTP_HOST is set, these emails are logged, not sent. Brevo (REST API) takes
# priority over SMTP when both are set — see src/lib/email/brevoAdapter.ts.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@picmychip.com
EMAIL_FROM_NAME=PicMyChip

# Shared secret required by POST /api/inventory-webhook (external stock sync)
INVENTORY_WEBHOOK_SECRET=dev_inventory_webhook_secret_change_me

# Zoho Books (https://www.zoho.com/books/api/v3/) — auto-creates a Sales
# Order when an order is created; an admin then clicks "Accept" on the order
# in the Payload admin (once stock/availability is confirmed) to convert it
# into the actual invoice — or it's picked up automatically here if someone
# converts it directly inside Zoho Books instead. Optional — no-ops entirely
# until all four of these are set. ORGANIZATION_ID is visible in the Zoho
# Books web app URL (books.zoho.in/app/<organization_id>#/home) or via
# GET /books/v3/organizations.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# Data center your Zoho account lives on (accounts.zoho.in/.com/.eu/.com.au/.jp)
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
# Seller/business state used for GST intra/inter-state decisions when
# Site Settings has not been filled yet.
ZOHO_BUSINESS_STATE=Karnataka
# Optional — JSON map of "<GST%>-inter"/"<GST%>-intra" (or a plain "<GST%>"
# key if your org only has one tax entry per rate) -> Zoho tax_id, only
# needed if the automatic match against your org's Settings > Taxes picks the
# wrong one — most orgs have TWO entries per rate (e.g. "GST18" a tax_group
# for intra-state, "IGST18" a separate tax for inter-state) and Zoho does not
# auto-swap between them.
# e.g. ZOHO_TAX_ID_MAP={"18-intra":"1911056000000026369","18-inter":"1911056000000026303"}
ZOHO_TAX_ID_MAP=
# NOT currently used by the sales-order-first flow — recording a payment
# happens manually in Zoho Books once you're ready, not automatically when
# the invoice is generated. src/lib/zoho/payments.ts still has the
# recordCustomerPayment function available if you want to wire auto-payment
# recording back in later; these three vars are what it reads.
ZOHO_PAYMENT_DEPOSIT_ACCOUNT_ID=
ZOHO_PAYMENT_DEPOSIT_ACCOUNT_NAME=
ZOHO_PAYU_PAYMENT_MODE=PAYU

# Shiprocket (https://apidocs.shiprocket.in/) — auto-books a shipment when an
# order is created. Optional — no-ops entirely until all three are set.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
# Used for courier-serviceability checks at checkout; not required for order/shipment creation itself.
SHIPROCKET_PICKUP_PINCODE=
